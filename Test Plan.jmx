        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="DB Connection Init">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import groovy.sql.Sql

if (vars.getObject(&quot;shared_sql&quot;) == null) {
    def dbUrl  = &apos;jdbc:postgresql://localhost:5432/jmeterdb&apos;
    def user   = &apos;jmeter_user&apos;
    def pass   = &apos;jmeter_pass&apos;
    def driver = &apos;org.postgresql.Driver&apos;

    def sql = Sql.newInstance(dbUrl, user, pass, driver)
    vars.putObject(&quot;shared_sql&quot;, sql)
    log.info(&quot;✅ PostgreSQL connection established and stored in vars.&quot;)
}
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
