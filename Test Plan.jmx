        <hashTree/>
        <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="JSR223 Listener">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def sql = vars.getObject(&quot;shared_sql&quot;)

if (sql) {
    sql.executeInsert(
      &quot;INSERT INTO results(time,label,success,elapsed,bytes,grpThreads,allThreads) VALUES (now(),?,?,?,?,?,?)&quot;,
      [prev.getSampleLabel(),
       prev.isSuccessful(),
       prev.getTime(),
       prev.getBytesAsLong(),
       ctx.getThreadGroup().getNumberOfThreads(),
       ctx.getThreadGroup().getNumberOfThreads()]
    )
} else {
    log.warn(&quot;⚠️  shared_sql not found in vars.&quot;)
}
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Listener>
        <hashTree/>
        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Close DB Connection" enabled="false">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def sql = vars.getObject(&quot;shared_sql&quot;)
if (sql) {
    sql.close()
    vars.remove(&quot;shared_sql&quot;)
    log.info(&quot;✅ PostgreSQL connection closed.&quot;)
}
</stringProp>
        </JSR223PreProcessor>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Close DB Connection 2">
